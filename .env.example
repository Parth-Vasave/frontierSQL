# Copy to .env and fill in. Never commit .env.

# --- Postgres (owner account: schema setup and data loading only) ---
POSTGRES_USER=emissions_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emissions

# --- Read-only agent account (the only account the API uses) ---
SQL_AGENT_PASSWORD=change-me-too
# Set automatically by docker-compose for the backend container. For running the
# backend outside Docker:
DATABASE_URL=postgresql://sql_agent:change-me-too@localhost:5432/emissions
# Optional: several databases, see databases.example.toml (overrides DATABASE_URL).
DATABASES_CONFIG=
# Allow adding databases from the UI. LOCAL / SELF-HOSTED USE ONLY: never enable on a
# public deployment, it lets any visitor make the server connect to arbitrary hosts.
ALLOW_UI_CONNECTIONS=false
# For scripts/seed_database.py outside Docker:
ADMIN_DATABASE_URL=postgresql://emissions_owner:change-me@localhost:5432/emissions

# --- Query guardrails ---
QUERY_TIMEOUT_SECONDS=5
MAX_RETRIES=2
MAX_ROWS=1000
# llm: answers written by the LLM and checked against the result (one extra call per question)
# template: answers built from the rows, no extra LLM call (e.g. for evaluation runs)
ANSWER_MODE=llm
# Candidate queries per question (1-5). Above 1, the result most candidates agree on wins: about
# 2-3x the LLM calls and tokens of a single candidate. Evaluation runs can set it with --candidates.
SQL_CANDIDATES=1

# --- Rate limits on POST /api/query (the endpoint that spends LLM quota; 0 = off) ---
# Per client address per minute, and across all clients per 24 hours. Each question makes
# 1-4 LLM calls (more with repairs and ANSWER_MODE=llm), so size the daily limit to your
# provider's quota. Kept in memory per process: several workers/instances each get their own.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
# Reverse proxies in front of the API that append the client address to X-Forwarded-For
# (1 behind a single load balancer). Leave 0 when clients connect directly: the header is
# then ignored, because any client can set it.
TRUSTED_PROXY_HOPS=0

# --- LLM (any OpenAI-compatible endpoint) ---
# Google Gemini free tier (key: https://aistudio.google.com/apikey):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Groq free tier (key: https://console.groq.com/keys):
#   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   (the evaluated model; free tier: 8K tokens/minute, 200K tokens/day)
# Cerebras (key: https://cloud.cerebras.ai; trial for gpt-oss-120b: $5 credit for 30 days,
# 5 requests/minute, 30K uncached tokens/minute, 1M tokens/hour and per day):
#   LLM_BASE_URL=https://api.cerebras.ai/v1   LLM_MODEL=gpt-oss-120b   LLM_MAX_OUTPUT_TOKENS=4096
#   LLM_REQUESTS_PER_MINUTE=4   (each call reserves prompt + output cap, ~7.5k tokens, against
#   the 30K per minute: 4 calls fit, 5 may not)
# Optional: cap on each reply, reasoning included (Cerebras reserves the cap against its rate
# limits before running a request), reasoning effort for reasoning models (low|medium|high), and
# spacing of LLM calls to stay under a per-minute request limit. Unset: the provider's defaults,
# calls not spaced.
# LLM_MAX_OUTPUT_TOKENS=
# LLM_REASONING_EFFORT=
# LLM_REQUESTS_PER_MINUTE=

# --- Host ports published by docker compose (change when 5432 / 8000 are already in use;
# then use the same port in DATABASE_URL and ADMIN_DATABASE_URL) ---
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
